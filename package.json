{
  "name": "statgpt-mcp-app-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "MCP App widget — speaks the spec io.modelcontextprotocol/ui protocol via @modelcontextprotocol/ext-apps and renders SDMX data (ag-grid table + echarts chart) with @epam/statgpt-* libs.",
  "scripts": {
    "start": "vite --port 4300 --strictPort",
    "build:local": "cross-env VITE_BASE_URL=http://localhost:4300 tsc --noEmit && cross-env VITE_BASE_URL=http://localhost:4300 vite build",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4300 --strictPort",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@epam/statgpt-conversation-view": "0.7.0-dev.32",
    "@epam/statgpt-sdmx-toolkit": "0.7.0-dev.32",
    "@epam/statgpt-shared-toolkit": "0.7.0-dev.32",
    "@epam/statgpt-ui-components": "0.7.0-dev.32",
    "@modelcontextprotocol/ext-apps": "^1.7.4",
    "ag-grid-community": "33.3.2",
    "ag-grid-react": "^33.3.2",
    "classnames": "^2.5.1",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.9",
    "autoprefixer": "^10.5.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "prettier": "^3.5.3",
    "sass": "^1.101.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "dompurify": "3.4.11"
  }
}
